<Window x:Class="NonSteamLauncher.Sync.UI.SyncStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Non-Steam Launcher"
        Width="740" MinWidth="660" MaxWidth="900"
        Height="490" MinHeight="420" MaxHeight="700"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        FontSize="13"
        Background="Transparent">

    <Window.Resources>
        <!-- Fluent 2 Unified Surface Card Style -->
        <Style x:Key="FluentCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>

        <!-- Segmented Tab Button Style -->
        <Style x:Key="FluentTabButtonStyle" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder" CornerRadius="5" Padding="14,0" Background="Transparent" BorderThickness="0" Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource AccentTintBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Accent Button Style -->
        <Style x:Key="FluentAccentButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" CornerRadius="5" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="White"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="FluentSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" CornerRadius="5" Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource CardBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ToggleSwitch Style -->
        <Style x:Key="FluentToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" 
                                Background="{DynamicResource LayerBrush}" 
                                BorderBrush="{DynamicResource TextTertiaryBrush}" BorderThickness="1.5">
                            <Ellipse x:Name="Thumb" Width="12" Height="12" HorizontalAlignment="Left" Margin="3,0,0,0" 
                                     Fill="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Critical / Destructive Accent Button Style -->
        <Style x:Key="FluentCriticalButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" CornerRadius="5" Background="{DynamicResource CriticalBrush}" BorderBrush="{DynamicResource CriticalBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="White"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource CriticalHoverBrush}"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource CriticalHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Subtle Icon Button Style -->
        <Style x:Key="FluentIconButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource CardBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <!-- Top Header & Tabs -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
            <!-- Footer Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header: Segmented Navigation + Active Device Pill -->
        <Border Grid.Row="0" Padding="18,12,18,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Segmented Tabs (Biblioteca / Carátulas) -->
                <Border Grid.Column="0" CornerRadius="6" Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1" Padding="2">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Tab 1: Library -->
                        <RadioButton x:Name="TabGames" Height="28" Style="{StaticResource FluentTabButtonStyle}" IsChecked="True" Checked="TabGames_Checked">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ContentControl x:Name="BadgeTabGames" VerticalAlignment="Center"/>
                                <TextBlock Text="&#xE8F1;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, sans-serif" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="TxtTabGames" Text="Biblioteca" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <Border x:Name="BadgeCountGames" CornerRadius="6" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1" Margin="6,0,0,0" Padding="5,0">
                                    <TextBlock x:Name="TxtTabGamesCount" Text="0" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>
                            </StackPanel>
                        </RadioButton>

                        <!-- Tab 2: Artwork -->
                        <RadioButton x:Name="TabSettings" Height="28" Style="{StaticResource FluentTabButtonStyle}" Margin="3,0,0,0" Checked="TabSettings_Checked">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ContentControl x:Name="BadgeTabSettings" VerticalAlignment="Center"/>
                                <TextBlock Text="&#xEB9F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, sans-serif" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="TxtTabSettings" Text="Carátulas" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- Right: Active Input Device Indicator Pill -->
                <Border Grid.Column="2" CornerRadius="12" Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1" Padding="9,4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="IconActiveDevice" Text="&#xE765;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, sans-serif" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="TxtActiveDevice" Text="Teclado y ratón" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 2. Main Content Area -->
        <Grid Grid.Row="1" Margin="18,0,18,8">
            <!-- TAB 1: GAMES VIEW -->
            <Grid x:Name="PanelGames" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Status Strip -->
                    <RowDefinition Height="*"/>    <!-- Games List -->
                </Grid.RowDefinitions>

                <!-- Clean, Quiet Status Strip with Fluent Indeterminate Progress Bar -->
                <Border Grid.Row="0" CornerRadius="5" Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1" Margin="0,0,0,6" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,6">
                            <TextBlock x:Name="TxtInfoIcon" Text="&#xE73E;" 
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, sans-serif" 
                                       FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" 
                                       Foreground="{DynamicResource InfoIconBrush}"/>
                            <!-- Spinning info sync glyph -->
                            <TextBlock x:Name="TxtInfoSyncSpin" Text="&#xE895;" 
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, sans-serif" 
                                       FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" 
                                       Foreground="{DynamicResource AccentBrush}"
                                       RenderTransformOrigin="0.5,0.5"
                                       Visibility="Collapsed">
                                <TextBlock.RenderTransform>
                                    <RotateTransform x:Name="InfoSyncRotate" Angle="0"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock x:Name="TxtInfoMessage" Text="4 juegos sincronizados en Steam" 
                                       FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Fluent 2 Slim Indeterminate ProgressBar at bottom edge of status strip -->
                        <ProgressBar x:Name="ProgressSync" Grid.Row="1" Height="2" 
                                     IsIndeterminate="False" Visibility="Collapsed"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource AccentBrush}"/>
                    </Grid>
                </Border>

                <!-- Compact Game Rows (Fluent List) -->
                <ScrollViewer x:Name="ScrollGames" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ListBox x:Name="ListGames" Background="Transparent" BorderThickness="0" 
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                             HorizontalContentAlignment="Stretch"
                             SelectionMode="Single">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,2"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="5" 
                                        Background="{Binding RowBgBrush}" 
                                        BorderBrush="{Binding RowBorderBrush}" 
                                        BorderThickness="{Binding RowBorderThickness}"
                                        Padding="10,6"
                                        MinHeight="44">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/> <!-- CheckBox (ONLY for pending) -->
                                            <ColumnDefinition Width="Auto"/> <!-- Thumbnail (32x32) -->
                                            <ColumnDefinition Width="*"/>    <!-- Full Title & Launcher Name -->
                                            <ColumnDefinition Width="Auto"/> <!-- Discrete Status (NO pill border) -->
                                            <ColumnDefinition Width="Auto"/> <!-- Delete / Remove Action Button -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Selection Checkbox (Visible ONLY when pending to sync) -->
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                                  Visibility="{Binding CheckBoxVisibility}" 
                                                  Cursor="Hand" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                        <!-- Thumbnail: Real Icon OR Custom Fluent Vector Placeholder -->
                                        <Border Grid.Column="1" Width="30" Height="30" CornerRadius="5" 
                                                Background="{Binding IconBgBrush}" 
                                                BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1" 
                                                Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Grid>
                                                <!-- Real Game Icon if available -->
                                                <Image Source="{Binding IconSource}" Width="22" Height="22" 
                                                       RenderOptions.BitmapScalingMode="HighQuality" 
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                       Visibility="{Binding IconVisibility}"/>
                                                <!-- Custom Fluent Gamepad Placeholder (Never blank document icon!) -->
                                                <TextBlock Text="&#xE7FC;" 
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, sans-serif" 
                                                           FontSize="14" Foreground="{Binding BrandBrush}" 
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                           Visibility="{Binding PlaceholderVisibility}"/>
                                            </Grid>
                                        </Border>

                                        <!-- Title and Launcher (Full width available) -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" 
                                                       Foreground="{DynamicResource TextPrimaryBrush}" 
                                                       TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <Ellipse Width="6" Height="6" Fill="{Binding BrandBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                <TextBlock Text="{Binding LauncherName}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Discrete Status (Subtle text + small icon, NOT a button pill) -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,4,0">
                                            <Grid VerticalAlignment="Center" Margin="0,0,5,0">
                                                <!-- Normal status glyph (e.g. checkmark \uE73E or subtle dot) -->
                                                <TextBlock Text="{Binding StatusGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, sans-serif" 
                                                           FontSize="11" Foreground="{Binding StatusBrush}" VerticalAlignment="Center"
                                                           Visibility="{Binding NormalStatusVisibility}"/>
                                                <!-- Spinning Sync Glyph (\uE895) when syncing -->
                                                <TextBlock x:Name="TxtItemSyncSpin" Text="&#xE895;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, sans-serif" 
                                                           FontSize="11" Foreground="{Binding StatusBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                           RenderTransformOrigin="0.5,0.5"
                                                           Visibility="{Binding SyncingVisibility}">
                                                    <TextBlock.RenderTransform>
                                                        <RotateTransform Angle="{Binding SyncSpinAngle}"/>
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                            </Grid>
                                            <TextBlock Text="{Binding StatusText}" FontSize="11.5" FontWeight="Normal" 
                                                       Foreground="{Binding StatusBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Synced Game Action Buttons (Artwork Picker + Remove) -->
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding DeleteButtonVisibility}">
                                            <!-- Choose Artwork Button -->
                                            <Border Width="28" Height="28"
                                                    Margin="8,0,0,0"
                                                    CornerRadius="4"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1">
                                                <Button Width="26" Height="26"
                                                        Padding="0"
                                                        Cursor="Hand"
                                                        ToolTip="{Binding ChooseArtworkToolTip}"
                                                        Style="{StaticResource FluentIconButtonStyle}"
                                                        Tag="{Binding}"
                                                        Click="BtnChooseArtwork_Click">
                                                    <TextBlock Text="&#xEB9F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, sans-serif"
                                                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>
                                            </Border>

                                            <!-- Delete / Remove Action Button -->
                                            <Border Width="28" Height="28" 
                                                    Margin="4,0,0,0" 
                                                    CornerRadius="4"
                                                    Background="{Binding DeleteButtonBgBrush}"
                                                    BorderBrush="{Binding DeleteButtonBorderBrush}"
                                                    BorderThickness="1">
                                                <Button Width="26" Height="26" 
                                                        Padding="0" 
                                                        Cursor="Hand"
                                                        ToolTip="{Binding DeleteToolTip}"
                                                        Style="{StaticResource FluentIconButtonStyle}"
                                                        Tag="{Binding}" 
                                                        Click="BtnDeleteGame_Click">
                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, sans-serif" 
                                                               FontSize="12" Foreground="{Binding DeleteIconBrush}" 
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Grid>

            <!-- TAB 2: ARTWORK VIEW (Clean, Simple, Zero Bloat) -->
            <Grid x:Name="PanelSettings" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Top">
                    <!-- Setting 1: Download Artwork Toggle -->
                    <Border x:Name="BorderSettingToggle" CornerRadius="6" Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1" Padding="14,10" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="TxtDownloadArtworkTitle" Grid.Column="0" Text="Descargar carátulas automáticamente" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ChkDownloadArtwork" Grid.Column="1" Style="{StaticResource FluentToggleSwitchStyle}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Setting 2: SteamGridDB API Key -->
                    <Border x:Name="BorderSettingApiKey" CornerRadius="6" Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1" Padding="14,10" Margin="0,0,0,6">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="TxtApiKeyTitle" Grid.Column="0" Text="API Key de SteamGridDB" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnPasteKey" Content="Pegar" Style="{StaticResource FluentSecondaryButtonStyle}" Height="28" Padding="12,0" Margin="0,0,5,0" Click="BtnPasteKey_Click"/>
                                    <Button x:Name="BtnClearKey" Content="Borrar" Style="{StaticResource FluentSecondaryButtonStyle}" Height="28" Padding="12,0" Margin="0,0,5,0" Click="BtnClearKey_Click"/>
                                    <Button x:Name="BtnGetKey" Content="Obtener clave" Style="{StaticResource FluentSecondaryButtonStyle}" Height="28" Padding="12,0" Click="BtnGetKey_Click"/>
                                </StackPanel>
                            </Grid>

                            <TextBox x:Name="TxtApiKey" Height="30" VerticalContentAlignment="Center" Padding="8,0" 
                                     Background="{DynamicResource CardBrush}" 
                                     Foreground="{DynamicResource TextPrimaryBrush}" 
                                     BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1" 
                                     FontSize="12" FontFamily="Segoe UI Variable Text, Consolas, sans-serif"/>
                        </StackPanel>
                    </Border>

                    <!-- Setting 3: Sync & Choose Artwork -->
                    <Border x:Name="BorderSettingSyncArtwork" CornerRadius="6" Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1" Padding="14,10" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="TxtSyncArtworkTitle" Grid.Column="0" Text="Personalizar carátulas en Steam" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Button x:Name="BtnSyncArtwork" Grid.Column="1" Content="Sincronizar y elegir carátulas" Style="{StaticResource FluentSecondaryButtonStyle}" Height="28" Padding="12,0" Click="BtnSyncArtwork_Click"/>
                        </Grid>
                    </Border>

                    <!-- Setting 4: Language Preference -->
                    <Border x:Name="BorderSettingLanguage" CornerRadius="6" Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="TxtLanguageLabel" Grid.Column="0" Text="Idioma" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                            <ComboBox x:Name="ComboLanguage" Grid.Column="1" Width="130" Height="28" VerticalContentAlignment="Center" SelectionChanged="ComboLanguage_SelectionChanged">
                                <ComboBoxItem Content="Español" Tag="es"/>
                                <ComboBoxItem Content="English" Tag="en"/>
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 3. Footer CommandBar -->
        <Border Grid.Row="2" Background="{DynamicResource FooterBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Discrete Shortcut Legend -->
                <StackPanel x:Name="PanelFooterLegend" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <!-- Badges populated dynamically based on active device -->
                </StackPanel>

                <!-- Right Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Primary Action Button (Only visible when pending games exist) -->
                    <Button x:Name="BtnPrimaryAction" Style="{StaticResource FluentAccentButtonStyle}" Margin="0,0,8,0" Click="BtnPrimaryAction_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="IconPrimarySpin" Text="&#xE895;" 
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, sans-serif" 
                                       FontSize="12" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5"
                                       Visibility="Collapsed">
                                <TextBlock.RenderTransform>
                                    <RotateTransform x:Name="PrimarySpinRotate" Angle="0"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <ContentControl x:Name="BadgePrimaryAction" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtPrimaryAction" Text="Sincronizar" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <!-- Close Button -->
                    <Button x:Name="BtnClose" Style="{StaticResource FluentSecondaryButtonStyle}" Click="BtnClose_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ContentControl x:Name="BadgeClose" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtClose" Text="Cerrar" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Confirmation Dialog Overlay (Fluent 2 ContentDialog) -->
        <Grid x:Name="DialogOverlay" Grid.Row="0" Grid.RowSpan="3" Background="#7F000000" Visibility="Collapsed">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" 
                    Width="440" MaxWidth="500" CornerRadius="8" 
                    Background="{DynamicResource CardBrush}" 
                    BorderBrush="{DynamicResource CardStrokeBrush}" 
                    BorderThickness="1" 
                    Padding="24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, sans-serif" 
                                   FontSize="18" Foreground="{DynamicResource CriticalBrush}" 
                                   Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtDialogTitle" Text="¿Eliminar de Steam?" 
                                   FontSize="16" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock x:Name="TxtDialogMessage" 
                               Text="¿Estás seguro de que deseas eliminar este acceso directo de Steam?" 
                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" 
                               TextWrapping="Wrap" Margin="0,0,0,20"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Confirm Delete Button -->
                        <Button x:Name="BtnConfirmDelete" Grid.Column="1" 
                                Height="32" Padding="14,0"
                                Style="{StaticResource FluentCriticalButtonStyle}" 
                                Margin="0,0,8,0" Click="BtnConfirmDelete_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ContentControl x:Name="BadgeConfirmDelete" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtConfirmDelete" Text="Eliminar" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Cancel Delete Button -->
                        <Button x:Name="BtnCancelDelete" Grid.Column="2" 
                                Height="32" Padding="14,0"
                                Style="{StaticResource FluentSecondaryButtonStyle}" 
                                Click="BtnCancelDelete_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ContentControl x:Name="BadgeCancelDelete" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtCancelDelete" Text="Cancelar" FontWeight="Normal" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
